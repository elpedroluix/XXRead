@using System.Globalization
@inject IServiceSettings ServiceSettings

@* Story in a list (MainPage, AuthorPage) : the XAML UI's StoryListItemDataTemplate *@

<MudPaper Class="story-card mx-3 my-1 pa-5" Elevation="1" @onclick="OnClick">
	<div class="pa-1">
		<MudText Align="Align.Center" Class="story-card-title">@Story.Title</MudText>

		@if (!string.IsNullOrWhiteSpace(Story.ChapterName))
		{
			<div class="px-12">
				<MudDivider Class="my-1" />
			</div>
			<MudText Align="Align.Center" Class="mud-text-secondary story-card-chapter">@Story.ChapterName</MudText>
		}
	</div>

	<div class="d-flex align-center gap-2 mt-5">
		<CategoryImage CategoryUrl="@Story.CategoryUrl" />
		<MudText Typo="Typo.body2" Class="mud-text-secondary">@Story.CategoryName</MudText>
	</div>

	<div class="d-flex justify-space-between mt-1">
		<MudText Typo="Typo.body2" Class="mud-text-secondary">@(MainPageConstants.MAINPAGE_BY_AUTHOR + Story.Author?.Name)</MudText>
		<MudText Typo="Typo.body2" Class="mud-text-secondary">@FormatReleaseDate(Story.ReleaseDate)</MudText>
	</div>
</MudPaper>

@code {
	private const string HDS_DATE_FORMAT = "dd-MM-yyyy HH:mm:ss";
	private const string DISPLAY_DATE_FORMAT = "dd/MM/yyyy HH:mm";

	[Parameter, EditorRequired]
	public Story Story { get; set; }

	[Parameter]
	public EventCallback OnClick { get; set; }

	/// <summary>
	/// The XAML UI's StoryDateTimeConverter : HDS has its own date format.
	/// </summary>
	private string FormatReleaseDate(string releaseDate)
	{
		if (string.IsNullOrWhiteSpace(releaseDate))
		{
			return string.Empty;
		}

		DateTime date = ServiceSettings.DataSource == DataSources.HDS
			? DateTime.ParseExact(releaseDate, HDS_DATE_FORMAT, CultureInfo.InvariantCulture)
			: DateTime.Parse(releaseDate);

		return date.ToString(DISPLAY_DATE_FORMAT);
	}
}
