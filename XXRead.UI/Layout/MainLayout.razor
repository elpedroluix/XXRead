@inherits LayoutComponentBase
@implements IDisposable
@inject IServiceTheme ServiceTheme
@inject IServicePlatform ServicePlatform
@inject IServiceNavigation ServiceNavigation
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="ServiceTheme.Theme" IsDarkMode="ServiceTheme.IsDarkMode" />
<MudPopoverProvider />
@* Same width for every dialog (the XAML popups were 350 wide on a phone) *@
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<MudLayout>
	<MudAppBar Elevation="1">
		@if (IsHomePage)
		{
			@* Temporary : opens the XAML settings until the Blazor settings are ported (step 8.5) *@
			<MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ServicePlatform.OpenXamlSettings" />
		}
		else
		{
			<MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Edge="Edge.Start" OnClick="ServiceNavigation.GoBack" />
		}

		<MudText Typo="Typo.h6" Class="ml-2 appbar-title">
			<SectionOutlet SectionName="@SECTION_TITLE" />
		</MudText>

		<MudSpacer />

		<SectionOutlet SectionName="@SECTION_ACTIONS" />

		@* Temporary : removed with the XAML UI (8.7) *@
		<MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Inherit" Edge="Edge.End"
					   title="Revenir à l'UI XAML" OnClick="ServicePlatform.SwitchToXamlUI" />
	</MudAppBar>

	<MudMainContent>
		@Body
	</MudMainContent>
</MudLayout>

@code {
	/// <summary>
	/// Section filled by each page with its title : <c>&lt;SectionContent SectionName="@MainLayout.SECTION_TITLE"&gt;</c>.
	/// </summary>
	public const string SECTION_TITLE = "appbar-title";

	/// <summary>
	/// Section filled by the pages that have actions in the AppBar (StoryPage menu).
	/// </summary>
	public const string SECTION_ACTIONS = "appbar-actions";

	private bool IsHomePage => string.IsNullOrEmpty(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

	protected override void OnInitialized()
	{
		ServiceTheme.ThemeChanged += OnThemeChanged;
	}

	protected override void OnAfterRender(bool firstRender)
	{
		if (!firstRender) return;

		ServicePlatform.SetStatusBarColor(ServiceTheme.StatusBarColor);
	}

	private void OnThemeChanged(object sender, EventArgs e)
	{
		ServicePlatform.SetStatusBarColor(ServiceTheme.StatusBarColor);
		InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		ServiceTheme.ThemeChanged -= OnThemeChanged;
	}
}
