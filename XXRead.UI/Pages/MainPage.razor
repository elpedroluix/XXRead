@page "/"
@inherits ViewModelComponentBase<MainPageViewModel>
@inject IJSRuntime JSRuntime
@inject IScrollManager ScrollManager

<SectionContent SectionName="@MainLayout.SECTION_TITLE">@ViewModel.Title</SectionContent>

@switch (ViewModel.ViewState)
{
	case ViewStateEnum.Loading:
		<LoadingView />
		break;

	case ViewStateEnum.Error:
		<ErrorView OnTryAgain="() => ViewModel.TryAgainCommand.Execute(null)" />
		break;

	default:
		<PullToRefresh OnRefresh="() => ViewModel.StoriesRefreshCommand.ExecuteAsync(null)">
			<div class="py-2">
				<MudButton Variant="Variant.Text" Color="Color.Inherit" Class="mx-2 category-control"
						   EndIcon="@Icons.Material.Filled.ArrowDropDown"
						   OnClick="() => ViewModel.CategoryTappedCommand.Execute(null)">
					@MainPageConstants.MAINPAGE_CATEGORY_CONTROL
					<u class="ml-1">@(ViewModel.CurrentCategory?.Title ?? MainPageConstants.MAINPAGE_CATEGORY_ALL)</u>
				</MudButton>

				@if (ViewModel.Stories == null || ViewModel.Stories.Count == 0)
				{
					<MudText Align="Align.Center" Class="mud-text-secondary pa-6">@MainPageConstants.MAINPAGE_NO_STORIES</MudText>
				}
				else
				{
					@foreach (Story story in ViewModel.Stories)
					{
						<StoryCard @key="story" Story="story" OnClick="() => OnStoryClick(story)" />
					}

					<div class="mx-3 mt-2">
						<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
								   OnClick="() => ViewModel.LoadMoreStoriesCommand.Execute(null)">
							@MainPageConstants.MAINPAGE_LOAD_MORE
						</MudButton>
					</div>
				}
			</div>
		</PullToRefresh>
		break;
}

@code {
	private const string MODULE_PATH = "./_content/XXRead.UI/Pages/MainPage.razor.js";

	protected override async Task OnInitializedAsync()
	{
		await ViewModel.OnAppearing();
	}

	/// <summary>
	/// Back from a story : the list is displayed where the user left it (Blazor does not restore the scroll position).
	/// </summary>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender || ViewModel.ScrollPosition <= 0) return;

		await ScrollManager.ScrollToAsync("html", 0, (int)ViewModel.ScrollPosition, ScrollBehavior.Auto);
	}

	private async Task OnStoryClick(Story story)
	{
		await using IJSObjectReference module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", MODULE_PATH);
		ViewModel.ScrollPosition = await module.InvokeAsync<double>("getScrollPosition");

		ViewModel.StoriesItemTappedCommand.Execute(story);
	}
}
