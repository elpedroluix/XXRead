@inject IServiceCategory ServiceCategory

@* Returns a CategorySelection ; canceled (null result) by the close button, the back button or a click outside *@

<MudDialog ContentClass="dialog-scroll-content">
	<DialogContent>
		<MudList T="Category">
			<MudListItem T="Category" OnClick="SelectAll">
				<div class="d-flex align-center gap-5">
					<span class="category-thumbnail"></span>
					<MudText>@MainPageConstants.MAINPAGE_CATEGORY_ALL</MudText>
				</div>
			</MudListItem>

			<MudDivider />

			@foreach (Category category in _categories)
			{
				<MudListItem T="Category" OnClick="() => Select(category)">
					<div class="d-flex align-center gap-5">
						<CategoryImage CategoryUrl="@category.Url" />
						<MudText>@category.Title</MudText>
					</div>
				</MudListItem>
			}
		</MudList>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" OnClick="Cancel">@GlobalConstants.CLOSE</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[CascadingParameter]
	private IMudDialogInstance MudDialog { get; set; }

	private List<Category> _categories = new List<Category>();

	protected override async Task OnInitializedAsync()
	{
		_categories = await ServiceCategory.GetCategoriesDB() ?? new List<Category>();
	}

	private void SelectAll()
	{
		Select(null);
	}

	private void Select(Category category)
	{
		MudDialog.Close(DialogResult.Ok(new CategorySelection(category)));
	}

	private void Cancel()
	{
		MudDialog.Cancel();
	}
}
