<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:XXRead.Helpers.Converters"
             xmlns:vms="clr-namespace:XXRead.ViewModels"
             x:Class="XXRead.Views.ContentViews.CurrentDataSourceView">
    <ContentView.Resources>
        <ResourceDictionary>

            <converters:DataSourceImageConverter x:Key="DataSourceImageConverter"/>

        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <HorizontalStackLayout HorizontalOptions="Start" Spacing="10">
            <Border Stroke="{DynamicResource ThemeFontSecondary}"
                    StrokeThickness="0.2"
                    StrokeShape="RoundRectangle 3"
                    BackgroundColor="Transparent"
                    Padding="-2">
                <Image Source="{Binding Image, Converter={StaticResource Key=DataSourceImageConverter}}"
                       HeightRequest="70"
                       WidthRequest="70"/>
            </Border>
            <Label Text="{Binding Name}"
                   TextColor="{DynamicResource ThemeFontPrimary}"
                   VerticalTextAlignment="Center"/>
        </HorizontalStackLayout>
    </ContentView.Content>
</ContentView>