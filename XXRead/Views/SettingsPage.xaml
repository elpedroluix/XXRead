<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:contentViews="clr-namespace:XXRead.Views.ContentViews"
             xmlns:converters="clr-namespace:XXRead.Helpers.Converters"
             xmlns:vm="clr-namespace:XXRead.ViewModels"
             x:DataType="vm:SettingsPageViewModel"
             x:Class="XXRead.Views.SettingsPage"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource Key=ThemeBackgroundPrimary}">
    <!--<Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="img.png"/>
    </Shell.BackButtonBehavior>-->
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:DataSourceImageConverter x:Key="DataSourceImageConverter"/>

            <Style TargetType="Button" x:Key="ButtonColorBackgroundTheme">
                <Setter Property="HeightRequest" Value="65"/>
                <Setter Property="WidthRequest" Value="65"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="BorderColor" Value="#999"/>
                <Setter Property="BorderWidth" Value="0.2"/>
                <Setter Property="Command" Value="{Binding ThemeBackgroundTappedCommand}"/>
                <Setter Property="CommandParameter" Value="{Binding Source={RelativeSource Self}, Path=BackgroundColor}"/>
            </Style>

            <Style TargetType="Button" x:Key="ButtonColorMainTheme" BasedOn="{StaticResource Key=ButtonColorBackgroundTheme}">
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="WidthRequest" Value="50"/>
                <Setter Property="FlexLayout.Basis" Value="25%"/>
                <Setter Property="Command" Value="{Binding ThemeMainTappedCommand}"/>
            </Style>

            <Style TargetType="Label" x:Key="LabelColorTheme">
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                <Setter Property="TextColor" Value="{DynamicResource Key=ThemeFontPrimary}"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Border BackgroundColor="{DynamicResource Key=ThemeBackgroundSecondary}"
                Margin="13"
                Padding="13"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 7">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Source des histoires" TextColor="{DynamicResource Key=ThemeFontPrimary}"/>
                    <Grid>
                        <Border Padding="5"
                                    Stroke="LightGray" StrokeThickness="0.2" BackgroundColor="{DynamicResource Key=ThemeBackgroundPrimary}"
                                    StrokeShape="RoundRectangle 7">
                            <ContentView>
                                <contentViews:CurrentDataSourceView BindingContext="{Binding CurrentDataSource}"/>
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding StoriesSourceTappedCommand}"/>
                                </ContentView.GestureRecognizers>
                            </ContentView>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="10" Margin="0,20">
                    <Label Text="Theme" TextColor="{DynamicResource Key=ThemeFontPrimary}"/>
                    <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                        <!-- Dark -->
                        <StackLayout>
                            <Button Style="{StaticResource Key=ButtonColorBackgroundTheme}" BackgroundColor="{StaticResource Key=BackgroundDarkPrimary}"/>
                            <Label Text="Dark" Style="{StaticResource Key=LabelColorTheme}"/>
                        </StackLayout>

                        <!-- Light -->
                        <StackLayout>
                            <Button Style="{StaticResource Key=ButtonColorBackgroundTheme}" BackgroundColor="{StaticResource Key=BackgroundLightPrimary}"/>
                            <Label Text="Light" Style="{StaticResource Key=LabelColorTheme}"/>
                        </StackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>


                <VerticalStackLayout Grid.Row="2" Spacing="10">
                    <Label Grid.Row="0" Text="Catégories affichées" TextColor="{DynamicResource Key=ThemeFontPrimary}"/>
                    <Button Grid.Row="1" Text="Gestion des catégories" 
                                BackgroundColor="{DynamicResource Key=ThemeMain}"
                                TextColor="{DynamicResource Key=ThemeFontPrimary}"
                                Command="{Binding DisplayCategoriesViewCommand}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </ContentPage.Content>
</ContentPage>